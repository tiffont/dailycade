{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dailycade.vercel.app"
        }
      ],
      "destination": "https://dailycadegames.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/c/:game",
      "destination": "/api/c?game=:game"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "staging.dailycadegames.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
